# ===========================================
# Amorphous molecular-box equilibration
# ==========================================

clear

# ---------------- General settings ----------------
units           real
dimension       3
boundary        p p p
atom_style      full

# ---------------- Read the packed structure ----------------
read_restart     restart_after_500ps_650K.restart

# ---------------- Force-field styles ----------------
pair_style      lj/cut/coul/long 12.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff
kspace_style    pppm 1e-4

include         coeff.in.mapped

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ---------------- Output ----------------
thermo          10000
thermo_style    custom step time temp press density vol &
                pe ke etotal ebond eangle edihed eimp evdwl ecoul &
                elong

thermo_modify   flush yes lost warn

# ============================================
# 1. Energy minimization: steepest descent
# ============================================
min_style       sd
min_modify      dmax 0.1
minimize        1.0e-4 1.0e-6 10000 100000
write_data      system_after_sd.data

# =============================================
# 2. Energy minimization: conjugate gradient
# =============================================
min_style       cg
min_modify      dmax 0.1
minimize        1.0e-6 1.0e-8 50000 500000
write_data      system_minimized.data
write_restart   system_minimized.restart

# ===========================================
# 3. Initial stabilization
# ===========================================
reset_timestep  0
timestep        0.1

velocity        all create 650.0 4928459 mom yes rot yes dist gaussian

fix             NPT1 all npt temp 650.0 650.0 100.0 &
                             iso 1.0 1.0 1000.0

dump            D1 all custom 100000 traj_650K_01fs.lammpstrj &
                id mol type q xu yu zu

dump_modify     D1 sort id

run             5000000

unfix           NPT1
undump          D1

write_restart   restart_after_500ps_650K.restart
write_data      system_after_500ps_650K.data

# ================================================
# 4. Apply SHAKE
# ================================================
fix             SHAKE all shake 1.0e-4 20 10000 m 1.008

# ================================================
# 5. NPT equilibration
# ================================================
timestep        2.0

fix             NPT2 all npt temp 650.0 650.0 100.0 &
                             iso 1.0 1.0 4000.0

dump            D2 all custom 100000 traj_20ns_650K.lammpstrj &
                id mol type q x y z

dump_modify     D2 sort id

run             10000000

unfix           NPT2
undump          D2

write_restart   restart_after_20ns_650K.restart
write_data      system_after_20ns_650K.data

# ===============================================
# 6. Cooling
# ================================================
fix             COOL all npt temp 650.0 300.0 100.0 &
                             iso 1.0 1.0 1000.0

dump            DC all custom 100000 traj_cooling_650_to_300K.lammpstrj &
                id mol type q xu yu zu

dump_modify     DC sort id

run             3500000

unfix           COOL
undump          DC

write_restart   restart_after_cooling.restart
write_data      system_after_cooling.data

# ==============================================
# 7. NPT equilibration at 300 K
# ==============================================
fix             NPT3 all npt temp 300.0 300.0 100.0 &
                             iso 1.0 1.0 1000.0

dump            D3 all custom 100000 traj_300K_first20ns.lammpstrj &
                id mol type q xu yu zu

dump_modify     D3 sort id

run             10000000

undump          D3

write_restart   restart_300K_after_20ns.restart

# ==============================================
# 8. Final 10 ns production sampling
# ==============================================
variable        firstdump equal step+500000

dump            PROD all custom 500000 traj_last10ns.lammpstrj &
                id mol type q xu yu zu

dump_modify     PROD sort id delay ${firstdump}

run             5000000

undump          PROD
unfix           NPT3
unfix           SHAKE

write_restart   system_final_300K.restart
write_data      system_final_300K.data

print "=================================================="
print "Simulation completed"
print "Final 10 ns sampled every 1 ns"
print "Expected number of production frames: 10"
print "=================================================="
